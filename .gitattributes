# Normalize text files to LF in the repository.
* text=auto

# Source code and configuration files.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
CMakeLists.txt text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows-specific scripts.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets and recorded data.
*.pgm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db3 binary
*.mcap binary
*.bag binary
*.tar.gz binary
*.xlsx binary

# Immutable release-evidence patches must retain their captured bytes.
docs/evidence/**/*.log binary
docs/evidence/**/*.patch binary
