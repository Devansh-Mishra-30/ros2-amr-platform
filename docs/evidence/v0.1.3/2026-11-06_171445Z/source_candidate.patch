+def _clock_probe():
+    probe = object.__new__(runtime_probe.SimulationReadinessProbe)
+    probe._lock = threading.Lock()
+    probe._clock_samples = deque(
+        maxlen=runtime_probe.CLOCK_SAMPLE_BUFFER_SIZE
+    )
+    return probe
+
