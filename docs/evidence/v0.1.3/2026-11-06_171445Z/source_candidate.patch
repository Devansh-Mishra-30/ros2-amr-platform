+    assert stopped.state.value == 'blocked'
+    assert stopped.reason == 'clock_stopped'
+
+    recovered = readiness.check_clock(
+        [(2.0, 10.0), (2.25, 10.1), (2.5, 10.2)],
+        use_sim_time=True, now=10.2, runtime_id='new-run',
+    )
